{
  "name": "rime-multilingual-demo",
  "version": "1.0.0",
  "description": "A full-stack voice agent application demonstrating seamless language switching using LiveKit Agents and Rime TTS",
  "keywords": [
    "livekit",
    "voice-agent",
    "multilingual",
    "rime-tts",
    "deepgram",
    "openai",
    "speech-to-text",
    "text-to-speech",
    "voice-assistant",
    "nextjs",
    "react",
    "python",
    "ai-agent"
  ],
  "author": "Jesse Hall <codeSTACKr@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/rime-multilingual-demo.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/rime-multilingual-demo/issues"
  },
  "homepage": "https://github.com/yourusername/rime-multilingual-demo#readme",
  "private": true,
  "scripts": {
    "dev:frontend": "cd frontend && pnpm dev",
    "dev:backend": "cd backend && uv run main.py dev",
    "build:frontend": "cd frontend && pnpm build",
    "install:frontend": "cd frontend && pnpm install",
    "setup:backend": "cd backend && uv sync && uv run main.py download-files",
    "format:frontend": "cd frontend && pnpm format",
    "lint:frontend": "cd frontend && pnpm lint"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  }
}
